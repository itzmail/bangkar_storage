# Bangkar Caddyfile — automatic HTTPS via Let's Encrypt.
# APP_DOMAIN / MINIO_DOMAIN come from compose environment.

{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

{$MINIO_DOMAIN} {
	encode zstd gzip

	# MinIO S3 API
	handle_path / {
		reverse_proxy minio:9000
	}

	# MinIO web console (optional — comment out if unused)
	handle_path /console* {
		reverse_proxy minio:9001
	}
}
