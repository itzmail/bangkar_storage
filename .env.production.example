# ---------------------------------------------------------------------------
# Bangkar production environment — copy this file to `.env` on the VPS:
#   cp .env.production.example .env && nano .env
# Then fill in real values. NEVER commit the real .env.
# Generate secrets with: openssl rand -base64 32
# ---------------------------------------------------------------------------

# --- MariaDB (used by compose to bootstrap the container) ---
MARIADB_ROOT_PASSWORD=CHANGE_ME_root_password
MARIADB_PASSWORD=CHANGE_ME_app_password

# --- App database connection (host = mariadb inside compose network) ---
# NOTE: use mysql:// scheme — the Prisma CLI (migrate deploy) only accepts
# mysql://, while the runtime adapter accepts both.
DATABASE_URL=mysql://bangkar:CHANGE_ME_app_password@mariadb:3306/bangkar

# --- MinIO ---
MINIO_ROOT_USER=bangkar_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
S3_ACCESS_KEY_ID=bangkar_admin
S3_SECRET_ACCESS_KEY=CHANGE_ME_minio_password
# Internal endpoint — server → MinIO (inside docker network: http://minio:9000)
S3_ENDPOINT=http://minio:9000
# Public endpoint — browsers use this for presigned uploads/downloads.
# Must be https://MINIO_DOMAIN (proxied by the HOST Caddy).
S3_PUBLIC_ENDPOINT=https://files-bangkar.CHANGE_ME.example.com
S3_REGION=us-east-1
S3_BUCKET=bangkar-files
S3_FORCE_PATH_STYLE=true

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
AUTH_TRUST_HOST=true

# --- Public URL (used to build share links) ---
# Must be the public HTTPS address of your app, e.g. https://bangkar.itsmail.dev
NEXT_PUBLIC_APP_URL=https://bangkar.CHANGE_ME.example.com

# --- Host Caddy reverse proxy (systemd, NOT a container) ---
# App binds 127.0.0.1:3100, MinIO binds 127.0.0.1:9100 / 9101.
# Add these sites to /etc/caddy/Caddyfile then `sudo systemctl reload caddy`:
#   bangkar.CHANGE_ME.example.com {
#     reverse_proxy 127.0.0.1:3100
#   }
#   files-bangkar.CHANGE_ME.example.com {
#     reverse_proxy 127.0.0.1:9100
#   }
APP_DOMAIN=bangkar.CHANGE_ME.example.com
MINIO_DOMAIN=files-bangkar.CHANGE_ME.example.com
