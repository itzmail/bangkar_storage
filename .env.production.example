# ---------------------------------------------------------------------------
# Bangkar production environment — copy this file to `.env` on the VPS:
#   cp .env.production.example .env && nano .env
# Then fill in real values. NEVER commit the real .env.
# Generate secrets with: openssl rand -base64 32
# ---------------------------------------------------------------------------

# --- MariaDB (used by compose to bootstrap the container) ---
MARIADB_ROOT_PASSWORD=CHANGE_ME_root_password
MARIADB_PASSWORD=CHANGE_ME_app_password

# --- App database connection (host = mariadb inside compose network) ---
DATABASE_URL=mariadb://bangkar:CHANGE_ME_app_password@mariadb:3306/bangkar

# --- MinIO ---
MINIO_ROOT_USER=bangkar_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
S3_ACCESS_KEY_ID=bangkar_admin
S3_SECRET_ACCESS_KEY=CHANGE_ME_minio_password
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=bangkar-files
S3_FORCE_PATH_STYLE=true

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
AUTH_TRUST_HOST=true

# --- Public URL (used to build share links) ---
# Must be the public HTTPS address of your app, e.g. https://files.domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
